        WHERE t1.deleted = 0
        ORDER BY t1.create_time DESC
    </select>-->
    <select id="selectCustomerDict" resultType="top.continew.starter.extension.crud.model.resp.LabelValueResp">

        SELECT
            t1.id AS value,
            CONCAT(t2.nickname, ' (', t2.username, ')') AS label
        FROM fin_customer AS t1
            LEFT JOIN sys_user AS t2 ON t2.id = t1.user_id
        WHERE t1.deleted = 0
        ORDER BY t1.create_time DESC
    </select>
</mapper>
